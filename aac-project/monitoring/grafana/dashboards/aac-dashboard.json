{
  "dashboard": {
    "title": "AAC - AutoAccount Creator Dashboard",
    "tags": ["aac", "accounts", "automation"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Total Accounts Created",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(account_creation_total)",
            "legendFormat": "Total"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Success Rate by Platform",
        "type": "gauge",
        "targets": [
          {
            "expr": "rate(account_creation_success_total{platform=\"discord\"}[5m]) / rate(account_creation_total{platform=\"discord\"}[5m]) * 100",
            "legendFormat": "Discord"
          },
          {
            "expr": "rate(account_creation_success_total{platform=\"gmail\"}[5m]) / rate(account_creation_total{platform=\"gmail\"}[5m]) * 100",
            "legendFormat": "Gmail"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Active Workers",
        "type": "stat",
        "targets": [
          {
            "expr": "celery_workers_active",
            "legendFormat": "Active"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Queue Length",
        "type": "stat",
        "targets": [
          {
            "expr": "celery_queue_length",
            "legendFormat": "Pending"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "Account Creation Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(account_creation_total[1m])",
            "legendFormat": "{{platform}}"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        }
      },
      {
        "id": 6,
        "title": "HTTP Request Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        }
      },
      {
        "id": 7,
        "title": "Proxy Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(proxy_status{status=\"active\"})",
            "legendFormat": "Active"
          },
          {
            "expr": "sum(proxy_status{status=\"dead\"})",
            "legendFormat": "Dead"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 0,
          "y": 12
        }
      },
      {
        "id": 8,
        "title": "Monthly Cost Tracking",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(account_cost_total)",
            "legendFormat": "Total Cost"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 12,
          "y": 12
        }
      }
    ],
    "schemaVersion": 16,
    "version": 1
  }
}
