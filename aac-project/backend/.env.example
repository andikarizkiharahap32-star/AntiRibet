# Application
APP_NAME="AAC - Auto Account Creator"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Database
DATABASE_URL="postgresql://aac_user:aac_password@postgres:5432/aac_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL="redis://redis:6379/0"
REDIS_SESSION_URL="redis://redis:6379/1"
REDIS_CELERY_BROKER="redis://redis:6379/2"
REDIS_CELERY_BACKEND="redis://redis:6379/3"

# Celery
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=1800
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# JWT Authentication
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_HOURS=8
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production-min-32-chars"

# LDAP/SSO
LDAP_ENABLED=true
LDAP_SERVER="ldap://ldap-server:389"
LDAP_BIND_DN="cn=admin,dc=company,dc=com"
LDAP_BIND_PASSWORD="ldap-password"
LDAP_USER_SEARCH_BASE="ou=users,dc=company,dc=com"
LDAP_USER_SEARCH_FILTER="(uid={username})"
LDAP_GROUP_SEARCH_BASE="ou=groups,dc=company,dc=com"
LDAP_ALLOWED_GROUP="cn=aac-users,ou=groups,dc=company,dc=com"
LDAP_STARTTLS=true
LDAP_TIMEOUT=3

# Session
SESSION_TIMEOUT_HOURS=8
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE="lax"

# Encryption (Fernet - AES-256)
FERNET_KEY="your-fernet-key-32-bytes-base64-encoded"
FERNET_KEY_NEW=""

# Proxy Providers
PROXY_PROVIDER="brightdata"
BRIGHTDATA_USERNAME="brightdata-user"
BRIGHTDATA_PASSWORD="brightdata-pass"
BRIGHTDATA_ZONE="residential"
SMARTPROXY_API_KEY="smartproxy-api-key"
SMARTPROXY_USERNAME="smartproxy-user"
SMARTPROXY_PASSWORD="smartproxy-pass"

# Captcha Solvers
CAPTCHA_PROVIDER="2captcha"
TWOCAPTCHA_API_KEY="2captcha-api-key"
ANTICAPTCHA_API_KEY="anticaptcha-api-key"
CAPTCHA_TIMEOUT_HCAPTCHA=120
CAPTCHA_TIMEOUT_RECAPTCHA=180

# Temp Mail Providers
TEMP_MAIL_PROVIDER="mailtm"
MAILTM_API_URL="https://api.mail.tm"
MAILTM_DOMAINS="mail.tm"
ONESECMAIL_API_URL="https://www.1secmail.com/api/v1"
MAILSAC_API_KEY="mailsac-api-key"
MAILSAC_API_URL="https://mailsac.com/api"

# IMAP Custom Domain
IMAP_ENABLED=false
IMAP_HOST="mail.example.com"
IMAP_PORT=993
IMAP_USERNAME="imap-user"
IMAP_PASSWORD="imap-pass"
IMAP_DOMAIN="example.com"

# SMS Providers
SMS_PROVIDER="5sim"
SIMS_API_KEY="5sim-api-key"
SIMS_API_URL="https://5sim.net/v1"
SMSACTIVATE_API_KEY="smsactivate-api-key"
SMSACTIVATE_API_URL="https://sms-activate.io/stubs/handler_api.php"
SMS_MAX_PRICE=0.5
SMS_TIMEOUT=60

# Discord
DISCORD_REG_URL="https://discord.com/register"
DISCORD_VERIFY_URL="https://discord.com/verify"
DISCORD_HCAPTCHA_SITEKEY="4c672d35-0701-42b2-88c3-78380b0db560"

# Gmail
GMAIL_REG_URL="https://accounts.google.com/signup"
GMAIL_RECAPTCHA_SITEKEY="6LfwuyUTAAAAAOAmoS0fdqijC2PbbdH4kjq62Y1b"

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
BROWSER_VIEWPORT_WIDTH=1366
BROWSER_VIEWPORT_HEIGHT=768
BROWSER_USER_AGENTS_COUNT=50

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_RETENTION_DAYS=30

# Cost Limits
MONTHLY_BUDGET_USD=50.0
BUDGET_ALERT_THRESHOLD_80=0.8
BUDGET_ALERT_THRESHOLD_95=0.95

# Worker Scaling
MIN_WORKERS=2
MAX_WORKERS=50
QUEUE_HIGH_THRESHOLD=50
QUEUE_LOW_THRESHOLD=10

# Export
EXPORT_MAX_RECORDS=10000
EXPORT_FILE_TTL_HOURS=24